# Install-time script: makes the installed retroshare-gui.app self-contained.
# Run once everything is installed into the bundle (the program, the other
# programs of a super-project, libretroshare in Contents/Frameworks, the
# RetroShare plugins, the data).
#
# 1. macdeployqt copies the Qt frameworks, the Qt plugins and every other
#    library the programs and the RetroShare plugins link (Homebrew's, ...)
#    into the bundle, and rewrites their install names.
# 2. Search paths pointing outside the bundle are removed from every binary in
#    it: the programs keep those of the build tree, and libraries copied from
#    Homebrew keep Homebrew's.
# 3. The bundle is signed again: the libraries copied in step 1 were modified
#    after they had been signed, and macOS on Apple Silicon refuses to load a
#    library whose signature does not match.

cmake_minimum_required(VERSION 3.16)

set(app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@RS_MACOS_BUNDLE_DIR@")
set(exe "${app}/Contents/MacOS/@RS_MACOS_BUNDLE_EXECUTABLE@")
if(NOT EXISTS "${exe}")
	message(FATAL_ERROR "no application bundle at ${app}")
endif()

# macdeployqt handles the bundle's main executable by itself, and what it is
# told of besides: the other programs, the RetroShare plugins
file(GLOB programs "${app}/Contents/MacOS/*")
file(GLOB plugins "${app}/@RS_MACOS_BUNDLE_PLUGIN_SUBDIR@/*.dylib")
set(macdeployqt_args "${app}" "-libpath=${app}/Contents/Frameworks")
foreach(binary IN LISTS programs plugins)
	if(NOT binary STREQUAL exe)
		list(APPEND macdeployqt_args "-executable=${binary}")
	endif()
endforeach()

message(STATUS "macdeployqt: ${app}")
execute_process(
	COMMAND "@MACDEPLOYQT_EXECUTABLE@" ${macdeployqt_args}
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE output
)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "macdeployqt failed (${result}):\n${output}")
endif()

# every binary of the bundle: the programs, the libraries and frameworks copied
# in, the Qt plugins, the RetroShare plugins
file(GLOB_RECURSE bundle_files LIST_DIRECTORIES false
	"${app}/Contents/MacOS/*"
	"${app}/Contents/Frameworks/*"
	"${app}/Contents/PlugIns/*"
	"${app}/@RS_MACOS_BUNDLE_PLUGIN_SUBDIR@/*"
)
foreach(binary IN LISTS bundle_files)
	if(IS_SYMLINK "${binary}")
		continue()
	endif()
	# fails on what is not a binary (a framework's Info.plist, ...)
	execute_process(COMMAND otool -l "${binary}"
		RESULT_VARIABLE result
		OUTPUT_VARIABLE load_commands
		ERROR_QUIET
	)
	if(NOT result EQUAL 0)
		continue()
	endif()
	string(REGEX MATCHALL "path /[^\n]* \\(offset" rpaths "${load_commands}")
	foreach(rpath IN LISTS rpaths)
		string(REGEX REPLACE "^path (.*) \\(offset$" "\\1" rpath "${rpath}")
		message(STATUS "removing the search path ${rpath} from ${binary}")
		execute_process(
			COMMAND install_name_tool -delete_rpath "${rpath}" "${binary}"
			RESULT_VARIABLE result
		)
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "cannot remove the search path ${rpath}")
		endif()
	endforeach()
endforeach()

message(STATUS "codesign (@RS_MACOS_CODESIGN_IDENTITY@): ${app}")
execute_process(
	COMMAND codesign --force --deep --sign "@RS_MACOS_CODESIGN_IDENTITY@" "${app}"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE output
)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "codesign failed (${result}):\n${output}")
endif()
execute_process(
	COMMAND codesign --verify --deep --strict "${app}"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE output
)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "the signed bundle does not verify:\n${output}")
endif()
