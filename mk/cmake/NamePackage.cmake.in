# CPack post-build script: gives the package the name every RetroShare release
# file has, on every system:
#
#   RetroShare-v<version>-<build day>-<commits>-g<commit>-lib-<commits>-g<commit>
#     -Qt-<Qt version>-<runtime>-<architecture>.<extension>
#
# <runtime> says what the package needs to run: glibc-<lowest glibc> on Linux,
# macos-<lowest macOS> on macOS, the MSYS2 environment it was built in on
# Windows. The lowest glibc and macOS are read from the files of the package,
# which is why the name is given here, once the package is made, and not by
# CPACK_PACKAGE_FILE_NAME, which CPack reads before it gathers the files.
#
# The parts known before that are set by PackageName.cmake.in, which also gives
# the folder inside an archive its name.
#
# CPack runs this script before it puts the package, under the name it chose,
# into CPACK_PACKAGE_DIRECTORY. The super-project sets that directory to
# <build dir>/package, CPack's work area; this script puts the package under
# its real name, with its checksum file, into the build directory.

cmake_minimum_required(VERSION 3.19)

# set by PackageName.cmake.in when cpack started
if(NOT RS_PACKAGE_NAME_HEAD OR NOT RS_PACKAGE_ARCHITECTURE)
	message(FATAL_ERROR "the package name parts of PackageName.cmake.in are missing")
endif()

# every file the package holds
file(GLOB_RECURSE files LIST_DIRECTORIES false "${CPACK_TEMPORARY_DIRECTORY}/*")

if(RS_PACKAGE_RUNTIME)
	# known before the files were gathered (Windows)
	set(runtime "${RS_PACKAGE_RUNTIME}")
elseif("@APPLE@")
	# the lowest macOS every binary of the package accepts
	set(lowest "")
	foreach(file IN LISTS files)
		if(IS_SYMLINK "${file}" OR file MATCHES "/Resources/")
			continue()
		endif()
		execute_process(COMMAND otool -l "${file}"
			RESULT_VARIABLE result
			OUTPUT_VARIABLE load_commands
			ERROR_QUIET
		)
		if(NOT result EQUAL 0)
			continue()
		endif()
		string(REGEX MATCH "LC_BUILD_VERSION[^=]*minos ([0-9.]+)" found "${load_commands}")
		if(NOT found)
			string(REGEX MATCH "LC_VERSION_MIN_MACOSX[^=]*version ([0-9.]+)" found "${load_commands}")
		endif()
		if(found AND (NOT lowest OR CMAKE_MATCH_1 VERSION_GREATER lowest))
			set(lowest "${CMAKE_MATCH_1}")
		endif()
	endforeach()
	if(NOT lowest)
		message(FATAL_ERROR "no binary found in ${CPACK_TEMPORARY_DIRECTORY}")
	endif()
	set(runtime "macos-${lowest}")
else()
	# the lowest glibc every binary of the package accepts: the highest
	# GLIBC_2.x symbol version one of them asks for
	set(lowest "")
	foreach(file IN LISTS files)
		if(IS_SYMLINK "${file}" OR NOT file MATCHES "/(bin|lib[^/]*)/")
			continue()
		endif()
		execute_process(COMMAND objdump -T "${file}"
			RESULT_VARIABLE result
			OUTPUT_VARIABLE symbols
			ERROR_QUIET
		)
		if(NOT result EQUAL 0)
			continue()
		endif()
		string(REGEX MATCHALL "GLIBC_2\\.[0-9]+(\\.[0-9]+)?" versions "${symbols}")
		list(REMOVE_DUPLICATES versions)
		foreach(glibc IN LISTS versions)
			string(REPLACE "GLIBC_" "" glibc "${glibc}")
			if(NOT lowest OR glibc VERSION_GREATER lowest)
				set(lowest "${glibc}")
			endif()
		endforeach()
	endforeach()
	if(NOT lowest)
		message(FATAL_ERROR "no binary found in ${CPACK_TEMPORARY_DIRECTORY}")
	endif()
	set(runtime "glibc-${lowest}")
endif()

set(name "${RS_PACKAGE_NAME_HEAD}-${runtime}-${RS_PACKAGE_ARCHITECTURE}")

set(output_directory "@CMAKE_BINARY_DIR@")
foreach(package IN LISTS CPACK_PACKAGE_FILES)
	get_filename_component(old_name "${package}" NAME)
	# what follows the name CPack gave: the extension, .tar.xz included
	string(LENGTH "${CPACK_PACKAGE_FILE_NAME}" length)
	string(SUBSTRING "${old_name}" ${length} -1 extension)
	set(named_package "${output_directory}/${name}${extension}")
	file(REMOVE "${named_package}" "${named_package}.sha256")
	file(COPY "${package}" DESTINATION "${output_directory}")
	if(NOT "${output_directory}/${old_name}" STREQUAL "${named_package}")
		file(RENAME "${output_directory}/${old_name}" "${named_package}")
	endif()
	file(SHA256 "${named_package}" checksum)
	file(WRITE "${named_package}.sha256" "${checksum}  ${name}${extension}\n")
	message(STATUS "package: ${named_package}")
endforeach()
