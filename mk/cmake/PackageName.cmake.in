# CPack project configuration file, read by cpack when it starts: the parts of
# the package name that are known before the files of the package are
# gathered. See NamePackage.cmake.in for the whole name.
#
# CPACK_PACKAGE_FILE_NAME is also the name of the folder inside an archive
# (.zip, .tar.xz). On Windows every part is known now, so the folder has the
# name of the archive. Elsewhere the runtime part (lowest glibc, lowest macOS)
# is read from the gathered files: the folder has the name without it.

string(TIMESTAMP rs_package_build_day "%Y%m%d")
string(CONCAT RS_PACKAGE_NAME_HEAD
	"RetroShare-v@rs_package_version@-${rs_package_build_day}@rs_package_commit@"
	"-lib-@rs_package_lib_commit@-Qt-@rs_package_qt_version@"
)
set(RS_PACKAGE_ARCHITECTURE "@rs_package_architecture@")
if("@WIN32@")
	set(RS_PACKAGE_RUNTIME "@rs_package_windows_runtime@")
	string(CONCAT CPACK_PACKAGE_FILE_NAME
		"${RS_PACKAGE_NAME_HEAD}-${RS_PACKAGE_RUNTIME}-${RS_PACKAGE_ARCHITECTURE}"
	)
else()
	set(CPACK_PACKAGE_FILE_NAME
		"${RS_PACKAGE_NAME_HEAD}-${RS_PACKAGE_ARCHITECTURE}"
	)
endif()
